# Database — Supabase Postgres
# Pooled (app runtime, port 6543, Transaction mode):
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (migrations, port 5432):
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase (client-side + server helpers)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE-ROLE-KEY]" # server only, never expose

# Auth.js (when wired): generate with `npx auth secret`
AUTH_SECRET="change-me"
